C4Container
    title Nivel 2 (conteineres) do Sistema de Bilhetagem e Mobilidade Urbana (versao final)

    Person(passageiro, "Passageiro", "Valida, recarrega e consulta")
    Person(auditoria, "Auditoria e Tribunal de Contas", "Audita o repasse e o rastro")

    System_Boundary(sistema, "Sistema de Bilhetagem e Mobilidade") {
        Container(validador, "Validador embarcado", "Edge, fila local append-only", "Aceita ou recusa em ate 300 ms mesmo sem rede")
        Container(gateway, "Gateway de API", "Gateway", "Autentica, roteia e registra o rastro")
        Container(nucleo, "Nucleo Transacional", "Monolito modular (esquemas separados)", "Validacao-servidor, Cartoes e Recarga, Integracao e Conformidade, Atendimento")
        Container(telemetria, "Servico de Telemetria", "Servico de ingestao", "Absorve o pico de posicoes GPS")
        Container(pipeline, "Depuracao de Telemetria", "Pipes and Filters", "Valida, limpa e reconcilia; retem o cru para auditoria")
        Container(info, "Informacao ao Passageiro", "Servico CQRS de leitura", "Projecao de chegada, escala so no pico")
        Container(financeiro, "Nucleo Financeiro", "Servico event-sourced", "Repasse reconstruivel; glosa de duplicidade")
        ContainerQueue(barramento, "Barramento de eventos", "Corretor de mensagens", "Entrega ao menos uma vez")
    }

    System_Ext(banco, "Banco e adquirente", "Liquidacao e conciliacao")

    Rel_D(passageiro, gateway, "Recarrega e consulta", "HTTPS")
    Rel_D(passageiro, validador, "Encosta o cartao", "NFC")
    Rel_D(auditoria, gateway, "Audita", "HTTPS")
    Rel_D(validador, nucleo, "Sincroniza validacoes", "HTTPS")
    Rel_D(gateway, nucleo, "Chama", "HTTPS")
    Rel_D(gateway, info, "Consulta chegada", "HTTPS")
    Rel_D(nucleo, barramento, "Publica Recarga/ViagemRealizada", "evento")
    Rel_D(telemetria, pipeline, "Posicoes cruas", "fluxo")
    Rel_D(pipeline, barramento, "Publica PosicaoDepurada", "evento")
    Rel_D(barramento, info, "Alimenta a projecao", "evento")
    Rel_D(barramento, financeiro, "Alimenta o repasse", "evento")
    Rel_D(financeiro, nucleo, "Solicita liquidacao", "chamada")
    Rel_D(nucleo, banco, "Liquida e concilia", "HTTPS")

    UpdateElementStyle(passageiro, $bgColor="#ffffff", $fontColor="#4a7f2c", $borderColor="#4a7f2c")
    UpdateElementStyle(auditoria, $bgColor="#ffffff", $fontColor="#4a7f2c", $borderColor="#4a7f2c")
    UpdateElementStyle(banco, $bgColor="#ffffff", $fontColor="#8a8a8a", $borderColor="#8a8a8a")
    UpdateElementStyle(validador, $bgColor="#ffffff", $fontColor="#1168bd", $borderColor="#1168bd")
    UpdateElementStyle(gateway, $bgColor="#ffffff", $fontColor="#1168bd", $borderColor="#1168bd")
    UpdateElementStyle(nucleo, $bgColor="#ffffff", $fontColor="#1168bd", $borderColor="#1168bd")
    UpdateElementStyle(telemetria, $bgColor="#ffffff", $fontColor="#1168bd", $borderColor="#1168bd")
    UpdateElementStyle(pipeline, $bgColor="#ffffff", $fontColor="#1168bd", $borderColor="#1168bd")
    UpdateElementStyle(info, $bgColor="#ffffff", $fontColor="#1168bd", $borderColor="#1168bd")
    UpdateElementStyle(financeiro, $bgColor="#ffffff", $fontColor="#1168bd", $borderColor="#1168bd")
    UpdateElementStyle(barramento, $bgColor="#ffffff", $fontColor="#1168bd", $borderColor="#1168bd")
    UpdateRelStyle(nucleo, banco, $offsetX="5", $offsetY="95")
    UpdateRelStyle(gateway, info, $offsetX="-85", $offsetY="25")
    UpdateRelStyle(financeiro, nucleo, $offsetX="60", $offsetY="70")
    UpdateRelStyle(nucleo, barramento, $offsetX="-70", $offsetY="80")
    UpdateRelStyle(barramento, financeiro, $offsetX="-45", $offsetY="15")
    UpdateRelStyle(telemetria, pipeline, $offsetX="10", $offsetY="0")
    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
