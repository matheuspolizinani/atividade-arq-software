%% Nivel 3 (componentes) do Nucleo Financeiro - versao final.
%% Estilo c4model.com (caixas brancas, borda/texto azul, cilindro = armazenamento).
%% Convencao de nivel 3 (secao 3.6): seta rotulada pelo TIPO do conector;
%% agrupamento tracejado = unidade de implantacao.
flowchart TB
    barramento["<b>Barramento de eventos</b><br/>[Container]"]
    nucleotrans["<b>Nucleo Transacional</b><br/>[Container: liquidacao via Integracao]"]

    subgraph alvo["Nucleo Financeiro: Repasse e Conciliacao — unidade de implantacao"]
        direction TB
        entrada["<b>Adaptador de entrada</b><br/>[Component]<br/>Consumidor de eventos + API"]
        app["<b>Servico de aplicacao de repasse</b><br/>[Component]<br/>Orquestra fechamento e glosa"]
        dominio["<b>Agregado de Repasse e Conciliacao</b><br/>[Component]<br/>Tarifa vigente na data; glosa de duplicidade"]
        catalogo["<b>Catalogo de regras tarifarias</b><br/>[Component]<br/>Estrategia versionada por vigencia (ADR 0007)"]
        identidade["<b>Gestor de identidade</b><br/>[Component]<br/>Cifra por titular; crypto-shredding (ADR 0008)"]
        projetor["<b>Projetor de conciliacao</b><br/>[Component]<br/>Reprocessa o fluxo (CQRS)"]
        saidaES["<b>Adaptador do event store</b><br/>[Component]<br/>Grava em modo append"]
    end

    store[("<b>Event store</b><br/>append-only")]
    keystore[("<b>Keystore</b><br/>identidade por titular")]
    leitura[("<b>Projecao de conciliacao</b><br/>subsidio + elegibilidade")]

    barramento -->|"evento (ViagemRealizada, TarifaVigente)"| entrada
    entrada -->|"chamada de procedimento"| app
    app -->|"chamada de procedimento"| dominio
    dominio -->|"chamada de procedimento (resolve por vigencia)"| catalogo
    dominio -->|"chamada de procedimento (cifra identidade)"| identidade
    app -->|"chamada de procedimento"| saidaES
    saidaES -->|"acesso a dado compartilhado (append)"| store
    identidade -->|"acesso a dado compartilhado"| keystore
    store -->|"fluxo (reprocessa)"| projetor
    projetor -->|"acesso a dado compartilhado"| leitura
    app -->|"evento (RepasseFechado, Glosa)"| barramento
    app -->|"chamada de procedimento remota (liquidacao)"| nucleotrans

    classDef comp fill:#ffffff,stroke:#1168bd,stroke-width:1.5px,color:#1168bd;
    classDef store fill:#ffffff,stroke:#1168bd,stroke-width:1.5px,color:#1168bd;
    classDef viz fill:#ffffff,stroke:#8a8a8a,stroke-width:1.5px,color:#5c5c5c;
    class entrada,app,dominio,catalogo,identidade,projetor,saidaES comp;
    class store,keystore,leitura store;
    class barramento,nucleotrans viz;
    style alvo fill:#f7fbff,stroke:#1168bd,stroke-width:1.5px,stroke-dasharray: 6 4,color:#1168bd;
